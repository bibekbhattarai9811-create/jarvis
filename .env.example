# Passcode the page asks for once per device (stops others on your Wi-Fi from controlling your PC).
JARVIS_PIN=
# Optional. Anthropic API key for faster replies. Without it Jarvis uses your logged-in Claude app (free with your plan).
ANTHROPIC_API_KEY=
# Optional. Full path to the claude CLI if it isn't found automatically.
CLAUDE_BIN=
# Optional. Claude CLI login token (from "claude setup-token") if the CLI is not logged in.
CLAUDE_CODE_OAUTH_TOKEN=
