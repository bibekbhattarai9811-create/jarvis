{
  "name": "jarvis",
  "private": true,
  "scripts": {
    "dev": "node scripts/cert.mjs && next dev -H 0.0.0.0 -p 3900 --experimental-https --experimental-https-key certificates/key.pem --experimental-https-cert certificates/cert.pem",
    "dev:local": "next dev -p 3900",
    "build": "next build",
    "start": "node scripts/cert.mjs && node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@vladmandic/face-api": "^1.7.15",
    "next": "^15.5.7",
    "node-forge": "^1.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "selfsigned": "^2.4.1",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
